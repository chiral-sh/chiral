{
  "name": "n8n-env",
  "version": "0.1.0",
  "description": "CLI for promoting n8n workflows between dev, staging, and production environments",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chiral": "dist/index.js"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "n8n",
    "workflow",
    "deployment",
    "environment",
    "chiral"
  ],
  "author": "Purvesh Gandhi",
  "license": "MIT",
  "dependencies": {
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "env-paths": "^4.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "ora": "^9.4.0",
    "simple-git": "^3.36.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fast-json-stable-stringify": "^2.1.2",
    "@types/node": "^20.0.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "memfs": "^4.57.6",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.0"
  }
}
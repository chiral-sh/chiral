{
  "name": "@chiral-sh/chiral",
  "version": "0.1.0",
  "description": "n8n workflow deployment CLI - promote workflows from dev to production without breaking live automations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chiral": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:dist": "vitest run --config vitest.integration.config.ts tests/integration/core-loop.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "keywords": [
    "n8n",
    "n8n-workflow",
    "workflow-deployment",
    "environment-promotion",
    "n8n-deployment",
    "workflow-promotion",
    "n8n-source-control",
    "credential-remapping",
    "devops",
    "cli",
    "staging",
    "production",
    "self-hosted",
    "automation"
  ],
  "author": {
    "name": "Purvesh Gandhi"
  },
  "homepage": "https://chiral.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/chiral-sh/chiral.git"
  },
  "bugs": {
    "url": "https://github.com/chiral-sh/chiral/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "ora": "^9.4.0",
    "simple-git": "^3.36.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "memfs": "^4.57.6",
    "testcontainers": "^12.0.2",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  }
}
